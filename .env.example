# ── Core ────────────────────────────────────────────────────────────────────
PORT=3000
# Public origin of the builder app. Used to build links in emails/checkouts.
APP_ORIGIN=http://localhost:3000
# Apex domain that published sites get a free subdomain on (slug.APP_DOMAIN).
APP_DOMAIN=localhost:3000
# Secret used to sign session cookies. Change this in production.
SESSION_SECRET=dev-only-change-me

# ── AI generation (optional) ────────────────────────────────────────────────
# Without a key, LaunchKit falls back to its built-in template engine, so the
# whole product still works end to end — it just won't write bespoke copy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Payments (optional) ─────────────────────────────────────────────────────
# Without keys, checkout runs in "sandbox" mode: real orders, simulated card.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
